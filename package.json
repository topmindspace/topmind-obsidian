{
  "name": "topmind-obsidian-plugin",
  "version": "4.16.5",
  "private": true,
  "description": "topmind Stream for Obsidian — 主区域动态流 + AI 沉淀副驾",
  "type": "module",
  "license": "MIT",
  "author": "TopMindSpace",
  "engines": {
    "node": ">=20.11"
  },
  "imports": {
    "#kernel/*": "./lib/*"
  },
  "scripts": {
    "predev": "node scripts/ensure-engine.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "prebuild": "node scripts/ensure-engine.mjs",
    "build": "node esbuild.config.mjs",
    "pretypecheck": "node scripts/ensure-engine.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "pack": "node scripts/pack-plugin.mjs",
    "pack:verify": "node scripts/verify-pack.mjs",
    "ensure-engine": "node scripts/ensure-engine.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "obsidian": "^1.13.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/topmindspace/topmind-obsidian.git"
  }
}
